pkgname=tokentally
pkgver=0.1.0
pkgrel=1
pkgdesc='See how many tokens Claude Code and Codex used, by day, week, and month'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/tokentally "$pkgdir/usr/bin/tokentally"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/tokentally.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/tokentally.svg"
  install -Dm644 "$startdir/tokentally.desktop" "$pkgdir/usr/share/applications/tokentally.desktop"
}
