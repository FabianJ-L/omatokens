# Maintainer: FabianJ-L <https://github.com/FabianJ-L>
pkgname=omatokens
pkgver=0.1.0
pkgrel=1
pkgdesc='See how many tokens Claude Code and Codex used, by day, week, and month'
arch=('x86_64' 'aarch64')
url='https://github.com/FabianJ-L/omatokens'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  mkdir -p build
  cd build
  qmake6 ../omatokens.pro
  make
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 build/omatokens "$pkgdir/usr/bin/omatokens"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/omatokens.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omatokens.svg"
  install -Dm644 pkgbuild/omatokens.desktop "$pkgdir/usr/share/applications/omatokens.desktop"
}
