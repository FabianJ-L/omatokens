<RCC>
    <qresource prefix="/">
        <file>qmldir</file>
        <file>Main.qml</file>
        <file>Colors.qml</file>
        <file>Card.qml</file>
        <file>FilterChip.qml</file>
        <file>PeriodTile.qml</file>
        <file>UsageChart.qml</file>
        <file>BreakdownCard.qml</file>
        <file>ActivityHeatmap.qml</file>
        <file>HelpOverlay.qml</file>
        <file alias="i18n/en.json">i18n/en.json</file>
        <file alias="i18n/de.json">i18n/de.json</file>
    </qresource>
</RCC>
