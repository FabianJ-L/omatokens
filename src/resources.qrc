        <file>Card.qml</file>
        <file>AnimatedNumber.qml</file>
        <file>DeltaPill.qml</file>
        <file>Segmented.qml</file>
        <file>StatTile.qml</file>
        <file>UsageChart.qml</file>
        <file>BreakdownList.qml</file>
        <file>ActivityHeatmap.qml</file>
        <file>HelpOverlay.qml</file>
        <file alias="i18n/en.json">i18n/en.json</file>
        <file alias="i18n/de.json">i18n/de.json</file>
    </qresource>
</RCC>
